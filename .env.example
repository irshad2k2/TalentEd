# ===================== TalentEd environment =====================
# Copy to .env and fill in. Never commit .env.

# ---- Public URL of the web app (used for CORS + share links) ----
PUBLIC_URL=http://localhost:5173

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper-at-least-32-characters
INTERNAL_API_KEY=change-me-internal-key-shared-by-api-and-ai

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=talented
MYSQL_USER=talented
MYSQL_PASSWORD=talentedpass
# Inside docker compose the host is "mysql"; when running the API on your machine use localhost
DATABASE_URL=mysql://talented:talentedpass@localhost:3306/talented

# ---- MongoDB ----
MONGO_URL=mongodb://localhost:27017/talented

# ---- Object storage (MinIO locally, AWS S3 in production) ----
S3_BUCKET=talented-videos
S3_REGION=ap-south-1
# For MinIO keep the endpoint. For real AWS S3 leave S3_ENDPOINT empty.
S3_ENDPOINT=http://localhost:9000
# URL the BROWSER uses to reach storage (differs from S3_ENDPOINT inside docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Razorpay (test mode keys from dashboard.razorpay.com) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
# Any OpenAI-compatible provider. Leave LLM_API_KEY empty to use extractive answers (no LLM).
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Web (read by Vite at build time) ----
VITE_API_URL=http://localhost:4000
VITE_RAZORPAY_KEY_ID=
